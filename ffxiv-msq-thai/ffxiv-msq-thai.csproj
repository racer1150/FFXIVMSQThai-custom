<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

	<PropertyGroup>
		<Version>1.9.4.2</Version>
		<IsPackable>false</IsPackable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Configurations>Debug;Release</Configurations>
		<Platforms>x64</Platforms>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="images/icon.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		
			<Content Include="THSarabunNew-Bold.ttf">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		
		<Content Include="../content/thai_dict.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<!-- ต้องลงใน content/ เพราะ DialogueDictionary.LoadAlignmentMap อ่านจาก <plugin>/content/alignment.json
		     ถ้าวางผิดที่มันจะ return เงียบ ๆ โดยไม่ log อะไรเลย -->
		<Content Include="../content/alignment.json">
			<Link>content/alignment.json</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<!-- ทุกโฟลเดอร์แพตช์ใต้ content/ (2.0, 2.x ... 7.56) แพตช์ใหม่จะติดมาเองโดยไม่ต้องแก้ไฟล์นี้
		     ไม่กิน alignment.json ที่อยู่ระดับบนสุด เพราะ include แยกไว้ข้างบนแล้ว -->
		<Content Include="../content/*/**/*.json">
			<Link>content/%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!-- ต้องวิ่งหลัง DefaultDalamudPackagerRelease ซึ่งเป็นตัวที่สร้าง latest.zip จริง
	     ของเดิมเขียน AfterTargets="Build;ZipPluginBundle" แต่ ZipPluginBundle ไม่มีอยู่จริง
	     (DalamudPackager ตั้งชื่อ target ว่า DefaultDalamudPackagerRelease) จึงเหลือ hook
	     ที่ Build อย่างเดียว และ target ในไฟล์โปรเจกต์วิ่งก่อน target ที่ import มาจาก NuGet
	     ผลคือก๊อป zip ของบิลด์ครั้งก่อนไปทับ release/latest.zip เงียบ ๆ ทุกครั้ง -->
	<Target Name="CopyZipToRelease" AfterTargets="DefaultDalamudPackagerRelease" Condition="'$(Configuration)' == 'Release'">
		<!-- ถ้าหา zip ไม่เจอ ให้บิลด์ล้มไปเลย ดีกว่าปล่อยให้ release/latest.zip ค้างของเก่าไว้แล้วปล่อยออกไป -->
		<Error Condition="!Exists('$(OutDir)$(AssemblyName)/latest.zip')" Text="ไม่พบ $(OutDir)$(AssemblyName)/latest.zip — DalamudPackager ไม่ได้สร้าง zip ให้ release/latest.zip จะเป็นของบิลด์เก่า" />
		<Copy SourceFiles="$(OutDir)$(AssemblyName)/latest.zip" DestinationFiles="$(MSBuildProjectDirectory)/../release/latest.zip" SkipUnchangedFiles="false" />
	</Target>

</Project>
